# Kaksha Environment Variables (Example)
# No secrets required for local hackathon demo
NEXT_PUBLIC_APP_NAME="Kaksha: The Space Academy"
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# Gemini API Configuration (Server-side only - never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.8-flash


